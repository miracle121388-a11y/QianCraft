# 运行策略：LIVE_MODE 尝试真实组件，DEMO_MODE 允许失败时回退到已标注缓存。
LIVE_MODE=false
DEMO_MODE=true

# DeepSeek（或其他 OpenAI 兼容接口）。不要把真实密钥提交到版本库。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=10000

# 本 Demo 默认使用本地确定性嵌入，让 LightRAG 在只有 LLM Key 时也能建图。
# 若后续切换云端嵌入，可在 Adapter 中接入下列配置。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=local-hash-384

# 主视觉生成使用独立、可替换的 OpenAI-compatible Images API。
# 未配置时工作台会明确显示 warning，不会把占位图冒充生成结果。
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_TIMEOUT_SECONDS=180

GPT_RESEARCHER_PATH=researcher_agent/gpt-researcher-main
MEDIACRAWLER_PATH=market-intel_agent/MediaCrawler-main
# MediaCrawler 与主运行时存在依赖版本冲突，使用隔离环境。
MEDIACRAWLER_PYTHON=market-intel_agent/MediaCrawler-main/.venv-qiancraft/Scripts/python.exe
LIGHTRAG_PATH=local_culture/LightRAG-main
LIGHTRAG_BASE_URL=

# MediaCrawler 受上游“非商业学习使用许可证 1.1”约束，默认关闭真实抓取。
# 只有在确认用途、平台条款并准备好自己的登录态后再开启。
MEDIACRAWLER_LIVE_ENABLED=false
# 四平台固定集合；MEDIACRAWLER_PLATFORM 仅为旧脚本兼容字段。
MEDIACRAWLER_PLATFORM=xhs
MEDIACRAWLER_PLATFORMS=xhs,dy,bili,wb
# cdp：优先连接本机已登录浏览器；qrcode：显式命令中展示二维码；cookie：用户自行提供。
MEDIACRAWLER_LOGIN_METHOD=cdp
MEDIACRAWLER_INTERACTIVE_LOGIN=false
MEDIACRAWLER_CDP_PORT=9222
MEDIACRAWLER_CDP_CONNECT_EXISTING=true
MEDIACRAWLER_HEADLESS=false
MEDIACRAWLER_COOKIE=
# Cookie 模式必须按平台分别配置；CDP/二维码模式无需填写。
MEDIACRAWLER_XHS_COOKIE=
MEDIACRAWLER_DY_COOKIE=
MEDIACRAWLER_BILI_COOKIE=
MEDIACRAWLER_WB_COOKIE=
# 正式 MVP 默认每平台 6 个统一关键词、每词一页（约60-120条），单平台最多保留150条。
MEDIACRAWLER_KEYWORD_LIMIT=6
MEDIACRAWLER_MAX_RESULTS=20
MEDIACRAWLER_PLATFORM_RECORD_LIMIT=150
MEDIACRAWLER_TIMEOUT_SECONDS=180

# 兼容用户给出的本地 api.txt；生产部署建议关闭并使用密钥管理服务。
ALLOW_API_TXT_FALLBACK=true

# 生产部署持久化目录。留空时继续使用仓库内 data 目录。
QIANCRAFT_WORKBENCH_DIR=
QIANCRAFT_TOOL_WORKSPACE_DIR=

# 文化来源巡检与四平台市场复检由 Tool API 内的持久调度器执行。
# 进程重启会续接计划；文化新资料先进入人工核验候选队列。
QIANCRAFT_CONTINUOUS_COLLECTION=true
QIANCRAFT_CULTURE_WATCH_MINUTES=360
QIANCRAFT_MARKET_REFRESH_MINUTES=240

# 生产站点入口保护；仅由部署平台的密钥管理注入。
QIANCRAFT_WEB_USERNAME=
QIANCRAFT_WEB_PASSWORD=
