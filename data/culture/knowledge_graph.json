  "records": [
    {
      "culture_id": "GZ-MIAO-EMBROIDERY",
      "culture_name": "贵州苗绣",
      "aliases": ["苗绣", "苗族刺绣", "黔绣中的苗绣"],
      "category": "传统美术",
      "region": ["贵州省", "黔东南苗族侗族自治州", "贵阳市花溪区", "剑河县", "雷山县", "松桃苗族自治县", "台江县", "施秉县"],
      "ethnic_groups": ["苗族"],
      "history": [
        "苗绣长期随苗族服饰与家庭传承延续，是记录族群历史、迁徙记忆、神话和支系身份的视觉载体，常被称为穿在身上的史书或无字天书。",
        "苗绣于2006年进入第一批国家级非物质文化遗产代表性项目名录，花溪、剑河、雷山等地形成差异显著的地方样式；松桃苗绣于2021年列为扩展项目。"
      ],
      "myths": [
        "苗族古歌《枫木歌》叙述蝴蝶由枫木心孕生，蝴蝶妈妈产下十二个蛋，孕育人类始祖姜央与世间万物。",
        "鹡宇鸟与蝴蝶妈妈同生于枫木，并孵化十二个蛋，因此鸟纹与蝴蝶纹共同连接祖源、生命和护佑。"
      ],
      "cultural_narratives": [
        "服饰纹样承担族群识别、支系区分和代际记忆功能。",
        "自然万物可相互化生，动物、植物与人的形象常以复合、夸张和变形方式共存。",
        "部分清水江流域绣片把开天辟地、射日月、洪水、姜央和张秀眉等叙事绣入服饰。"
      ],
      "core_values": ["生命延续", "祖源记忆", "自然共生", "守护与祝福", "族群身份", "女性创造与代际传承"],
      "totems": ["蝴蝶妈妈", "鹡宇鸟", "枫木", "苗龙", "太阳"],
